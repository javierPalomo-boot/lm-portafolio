<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Formato de dirección IPv4 -->
    <xs:simpleType name="tipoIP">
        <xs:restriction base="xs:string">
            <xs:pattern value="([0-9]{1,3}\.){3}[0-9]{1,3}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Formato de dirección MAC -->
    <xs:simpleType name="tipoMAC">
        <xs:restriction base="xs:string">
            <xs:pattern value="([0-9A-F]{2}-){5}[0-9A-F]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Estructura del inventario -->
    <xs:element name="inventario">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="equipo" minOccurs="5" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="ip" type="tipoIP"/>
                            <xs:element name="mac" type="tipoMAC"/>
                            <xs:element name="ubicacion" type="xs:string"/>
                            <xs:element name="fechaCompra" type="xs:date" minOccurs="0"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
